# GEMINI_API_KEY: Required for Gemini AI API calls (Transcription, Translation, Voiceover).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FISH_API_KEY: Required for Fish Audio ASR transcription and s2.1-pro-free TTS dubbing.
# Stored only on the backend server and never exposed to client code.
FISH_API_KEY="MY_FISH_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STORAGE_DIR: Local filesystem directory for uploaded videos, logos, audio, and exports.
STORAGE_DIR="./storage"

# MAX_UPLOAD_SIZE_MB: Maximum allowed video upload size in MB (default 2048 MB).
MAX_UPLOAD_SIZE_MB="2048"

# TEMP_RETENTION_HOURS: Auto-cleanup threshold for temporary processing files.
TEMP_RETENTION_HOURS="24"
